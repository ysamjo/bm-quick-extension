{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getdata",
  "main": "getdata-entry.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "LEGACY_WORKER",
      "service": "ebay-price-api"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BM_CACHE",
      "id": "4c9a0fcf9b1243adac729b13f7960943"
    }
  ],
  "ratelimits": [
    {
      "name": "UPSTREAM_RATE_LIMITER",
      "namespace_id": "42154",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "UPSTREAM_IP_RATE_LIMITER",
      "namespace_id": "42155",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ]
}
