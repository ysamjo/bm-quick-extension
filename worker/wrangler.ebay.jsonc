{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebay-price-api",
  "main": "ebay-worker.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "EBAY_MARKETPLACE_ID": "EBAY_DE",
    "DRAFT_PRICE_UNDERCUT_EUR": "0.01",
    "EBAY_DRAFT_WRITES_ENABLED": "false",
    "LEGO_IMAGES_ENABLED": "false"
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "UPSTREAM_RATE_LIMITER",
      "namespace_id": "42154",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "UPSTREAM_IP_RATE_LIMITER",
      "namespace_id": "42155",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ]
}
