{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebay-price-api",
  "main": "ebay-worker.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "EBAY_MARKETPLACE_ID": "EBAY_DE",
    "EBAY_RUNAME": "Andreas_Stegman-AndreasS-bm-PRD-jobnjgdy",
    "EBAY_USER_SCOPES": "https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.account",
    "EBAY_CATEGORY_ID": "19006",
    "EBAY_FULFILLMENT_POLICY_ID": "263481355013",
    "EBAY_PAYMENT_POLICY_ID": "256321308013",
    "EBAY_RETURN_POLICY_ID": "256322777013",
    "EBAY_MERCHANT_LOCATION_KEY": "kuppenheim-main",
    "EBAY_REGULATORY_JSON": "{\"manufacturer\":{\"companyName\":\"LEGO System A/S\",\"addressLine1\":\"Aastvej 1\",\"city\":\"Billund\",\"postalCode\":\"7190\",\"country\":\"DK\",\"contactUrl\":\"https://www.lego.com/de-de/service/contact-us\"}}",
    "DRAFT_PRICE_UNDERCUT_EUR": "0.01",
    "EBAY_FEE_PERCENT": "14.28",
    "EBAY_FEE_FIXED_EUR": "0.5355",
    "ACTUAL_SHIPPING_COST_EUR": "6.99",
    "PACKAGING_COST_EUR": "0",
    "MIN_PROFIT_EUR": "10",
    "EBAY_DRAFT_WRITES_ENABLED": "false",
    "LEGO_IMAGES_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "EBAY_OAUTH_STORE",
      "id": "c1a2d3eb54ba4cf18187a8ff5db2c4e2"
    }
  ],
  "ratelimits": [
    {
      "name": "UPSTREAM_RATE_LIMITER",
      "namespace_id": "42154",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "UPSTREAM_IP_RATE_LIMITER",
      "namespace_id": "42155",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ]
}
